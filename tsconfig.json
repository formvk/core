{
  "compilerOptions": {
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "module": "ESNext",
    "target": "ES2022",
    "allowJs": false,
    "noUnusedLocals": false,
    "preserveConstEnums": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "inlineSources": true,
    "declaration": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "paths": {
      "@formvk/*": ["./packages/*/src"]
    },
    "resolveJsonModule": true
  }
}
