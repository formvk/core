{
  "name": "formvk-core",
  "version": "1.0.0",
  "description": "Formvk Core",
  "keywords": [
    "core",
    "form",
    "formvk",
    "formvk-core"
  ],
  "license": "MIT",
  "author": "yiyunwan",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix-dangerously",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@formvk/reactive": "workspace:^",
    "@formvk/schema": "workspace:^",
    "@formvk/vue": "workspace:^",
    "@microsoft/api-extractor": "^7.60.1",
    "@rollup/plugin-swc": "^0.4.1",
    "@swc/core": "^1.16.22",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/reactivity": "3.6.0-rc.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitepress": "2.0.0-alpha.21",
    "vitest": "^5.1.0",
    "vue": "3.6.0-rc.12"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --deny-warnings",
      "oxfmt"
    ],
    "*.{json,jsonc,md,mdx,css,less,scss,html,yml,yaml}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.18.0"
}
