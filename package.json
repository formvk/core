{
  "name": "formvk-core",
  "version": "1.0.0",
  "private": true,
  "description": "Formvk Core",
  "keywords": [
    "core",
    "form",
    "formvk",
    "formvk-core"
  ],
  "license": "MIT",
  "author": "yiyunwan",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix-dangerously",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "preversion": "pnpm install --frozen-lockfile && pnpm build && pnpm exec oxlint --deny-warnings && pnpm format:check && pnpm exec vitest run && pnpm docs:build",
    "version:release": "lerna version",
    "version:alpha": "lerna version --conventional-prerelease --preid alpha",
    "version:beta": "lerna version --conventional-prerelease --preid beta",
    "version:rc": "lerna version --conventional-prerelease --preid rc",
    "version:exit-pre": "lerna version --conventional-graduate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@formvk/core": "workspace:~",
    "@formvk/react": "workspace:~",
    "@formvk/reactive": "workspace:~",
    "@formvk/reactive-react": "workspace:~",
    "@formvk/schema": "workspace:~",
    "@formvk/vue": "workspace:~",
    "@microsoft/api-extractor": "^7.60.1",
    "@rollup/plugin-swc": "^0.4.1",
    "@swc/core": "^1.16.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/reactivity": "^3.6.0-rc.15",
    "husky": "^9.1.7",
    "lerna": "^10.1.1",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.94.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.68.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitepress": "^2.0.0-alpha.21",
    "vitepress-demo-plugin": "^1.8.0",
    "vitepress-plugin-llms": "^1.15.0",
    "vitest": "^5.1.1",
    "vue": "^3.6.0-rc.15"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --deny-warnings",
      "oxfmt"
    ],
    "*.{json,jsonc,md,mdx,css,less,scss,html,yml,yaml}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.18.0"
}
